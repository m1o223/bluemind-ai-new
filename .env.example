NODE_ENV=development
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:5000

MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
EMAIL_PROVIDER=console
EMAIL_FROM=BlueMind AI <no-reply@yourdomain.com>
EMAIL_DEV_MODE=true
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=true
EMAIL_SEND_RETRIES=2
EMAIL_SEND_RETRY_DELAY_MS=750
EMAIL_TEST_TO=
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
PASSWORD_RESET_CODE_TTL_MINUTES=15
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
