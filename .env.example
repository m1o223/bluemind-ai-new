NODE_ENV=production
PORT=10000
API_PREFIX=/api
CORS_ORIGIN=https://bluemind-frontend.vercel.app
FRONTEND_URL=https://bluemind-frontend.vercel.app
BACKEND_PUBLIC_URL=https://bluemind-ai-new.onrender.com
REQUEST_BODY_LIMIT=1mb
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
MONGO_URI=
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
MONGODB_AUTH_SOURCE=admin
MONGODB_TLS=true
MONGODB_CONNECT_TIMEOUT_MS=15000
MONGODB_RECONNECT_INTERVAL_MS=10000

JWT_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
AUTH_REFRESH_COOKIE_NAME=bluemind_refresh
AUTH_OAUTH_STATE_COOKIE_NAME=bluemind_oauth_state
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
EMAIL_PROVIDER=console
EMAIL_FROM=BlueMind AI <no-reply@yourdomain.com>
EMAIL_DEV_MODE=true
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=true
EMAIL_SEND_RETRIES=2
EMAIL_SEND_RETRY_DELAY_MS=750
EMAIL_TEST_TO=
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
PASSWORD_RESET_CODE_TTL_MINUTES=15
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_INSTANT_MODEL=
OPENAI_THINKING_MODEL=
OPENAI_DEEP_THINKING_MODEL=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEMPERATURE=0.7

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://bluemind-ai-new.onrender.com/api/auth/google/callback

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

DEFAULT_TIMEZONE=UTC
IMAGE_UPLOAD_DIR=uploads/images
IMAGE_UPLOAD_MAX_BYTES=8388608
IMAGE_CHAT_MAX_ATTACHMENTS=4
IMAGE_GENERATION_MAX_RESULTS=1

REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_CRON=* * * * *
REMINDER_BATCH_SIZE=50
REMINDER_RETRY_DELAY_MS=300000
REMINDER_MAX_NOTIFICATION_ATTEMPTS=3
REMINDER_MISSED_AFTER_MINUTES=60

MEMORY_MAX_MESSAGES=24
MEMORY_SHORT_TERM_MESSAGES=12
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_PINNED_LIMIT=8
MEMORY_CONTEXT_MAX_CHARS=12000
MEMORY_SUMMARY_AFTER_MESSAGES=18
MEMORY_SUMMARY_INTERVAL_MESSAGES=8
